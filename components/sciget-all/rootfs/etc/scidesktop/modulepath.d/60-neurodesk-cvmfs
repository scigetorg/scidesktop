#!/bin/sh
# Modules for containers on the Neurodesk CVMFS share:
# - In scidesktop (sciget-all) and neurodesktop (sciget-neuroimaging), exposes
#   /cvmfs/neurodesk.ardc.edu.au/neurodesk-modules/*/.
# - In narrowed non-neuroimaging domain images (e.g. microdesktop), exposes
#   only a per-catalog filtered symlink view of /cvmfs/neurodesk.ardc.edu.au/containers/modules
#   so Lmod lists that domain's tools instead of every Neurodesk module.
exec /opt/scidesktop/cvmfs-domain-modules
