#!/bin/bash
# Regenerates the three locks:
#   linux-64.lock, linux-aarch64.lock
#                              the interpreter and PostgreSQL per architecture,
#                              as explicit conda package lists (../conda-lock)
#   requirements.lock          the workshop kernel: requirements.in and
#                              upstream's docker/base/requirements.txt
#   airflow-requirements.lock  Airflow: airflow-requirements.in and upstream's
#                              docker/airflow/requirements.txt, preferring the
#                              versions in Airflow's constraints for its pin
# Upstream's files are read at AI_READY_COMMIT (docker-bake.hcl). The pip locks
# record that commit, and the build refuses a lock made for another one.
set -euo pipefail
cd "$(dirname "$0")"
AI_READY_COMMIT=$(sed -n 's/^variable "AI_READY_COMMIT" { default = "\(.*\)" }$/\1/p' ../../docker-bake.hcl)
[ -n "${AI_READY_COMMIT}" ] || { echo "AI_READY_COMMIT not found in docker-bake.hcl" >&2; exit 1; }
../conda-lock .
python_version=$(grep -o '/python-3\.[0-9]*' linux-64.lock | head -1 | cut -d- -f2)
airflow_version=$(sed -n 's/^apache-airflow==\(.*\)$/\1/p' airflow-requirements.in)
[ -n "${airflow_version}" ] || { echo "apache-airflow pin not found in airflow-requirements.in" >&2; exit 1; }

# A fixed relative folder, so the "via -r" notes in the locks do not change
# from run to run.
rm -rf upstream && mkdir upstream
trap 'rm -rf upstream' EXIT
raw="https://raw.githubusercontent.com/IntersectAustralia/ai-ready-containers/${AI_READY_COMMIT}"
curl -fsSL -o upstream/base-requirements.txt "${raw}/docker/base/requirements.txt"
curl -fsSL -o upstream/airflow-requirements.txt "${raw}/docker/airflow/requirements.txt"
# Upstream's airflow requirements capped cryptography<46.0.0 for Airflow 3.1.x;
# Airflow 3.4+ supports cryptography 50.x, which fixes multiple CVEs in 45.x.
sed -i 's/^cryptography>=41\.0\.0,<46\.0\.0$/cryptography>=46.0.5/' upstream/airflow-requirements.txt
if grep -qE '^cryptography.*<46' upstream/airflow-requirements.txt; then
    echo "ai-ready/lock: upstream cryptography<46 cap was not removed; update sed pattern" >&2
    exit 1
fi
curl -fsSL -o upstream/airflow-constraints.txt \
    "https://raw.githubusercontent.com/apache/airflow/constraints-${airflow_version}/constraints-${python_version}.txt"

# --universal: one lock for every architecture (see ../selkies/lock).
compile() {
    local output="$1" input="$2"
    shift 2
    uv pip compile "${input}" "$@" --quiet --generate-hashes --no-header \
        --python-version "${python_version}" --universal \
        --output-file "${output}"
    sed -i "1i # Generated by ./lock from ${input} and ai-ready-containers@${AI_READY_COMMIT}. Do not edit." "${output}"
}
# Airflow's constraints cannot be applied as constraints: they pin a
# cryptography older than MLflow accepts. uv prefers the versions already in
# the output file, so starting from the constraints keeps Airflow's tested
# versions wherever the workshop's requirements allow them.
cp upstream/airflow-constraints.txt airflow-requirements.lock
compile airflow-requirements.lock airflow-requirements.in upstream/airflow-requirements.txt
# The kernel starts from Airflow's lock for the same reason: a model a DAG
# trains is loaded in a notebook, so both use one scikit-learn and MLflow.
cp airflow-requirements.lock requirements.lock
compile requirements.lock requirements.in upstream/base-requirements.txt
echo "requirements.lock: $(grep -c '==' requirements.lock) packages; airflow-requirements.lock: $(grep -c '==' airflow-requirements.lock) packages"
