#!/bin/sh
# The modules `sciget install` writes: <module_dir>/<catalog> for each catalog
# in use, listed before they exist so a module installed later in a session
# is found by the next shell.
command -v sciget >/dev/null 2>&1 || exit 0
dir=$(sciget config get module_dir 2>/dev/null) || exit 0
[ -n "${dir}" ] || exit 0
sciget catalog list 2>/dev/null | awk -F '\t' -v dir="${dir}" '$2 ~ /^[0-9]+$/ { print dir "/" $1 }'
