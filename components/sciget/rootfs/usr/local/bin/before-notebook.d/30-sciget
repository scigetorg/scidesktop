#!/bin/bash
# Downloads the sciget catalogs into the user's cache in the background, so
# `sciget find` works from the first terminal. The image's settings and
# catalogs are sciget's system layer (/etc/sciget), read on every run under
# the user's own; nothing is copied into the home.
#
# SCIDESKTOP_SCIGET_REFRESH: yes (default) | no
set -u

[ "${SCIDESKTOP_SCIGET_REFRESH:-yes}" = yes ] || exit 0

if [ "$(id -u)" -eq 0 ]; then
    user="${NB_USER:-jovyan}"
    home="$(getent passwd "${user}" | cut -d: -f6)"
    as_user() { runuser -u "${user}" -- env HOME="${home}" "$@"; }
else
    home="${HOME}"
    as_user() { "$@"; }
fi

# The log is opened by the user's shell, so root never owns it.
as_user bash -c 'mkdir -p "$1" && exec timeout 300 sciget refresh >"$1/refresh.log" 2>&1' \
    _ "${home}/.cache/sciget" </dev/null &
echo "[sciget] refreshing catalogs in the background"
exit 0
