#!/bin/bash
# Re-enables @jupyterhub/jupyter-server-proxy in ~/.jupyter/labconfig/page_config.json
# when migrating a persistent home previously written by legacy neurodesktop
# (identified by its "neurodeskSupporter" key alongside the disabled extension).
# Deliberate user disables (without legacy neurodesktop state) are left alone.
set -u

if [ "$(/usr/bin/id -u)" -eq 0 ]; then
    if [ -x /opt/scidesktop/run-as-user ]; then
        exec /opt/scidesktop/run-as-user "$0" "$@"
    fi
    echo "[jupyter-env] skipping page_config.json migration: /opt/scidesktop/run-as-user unavailable while running as root" >&2
    exit 0
fi

if [ -z "${HOME:-}" ]; then
    exit 0
fi

/opt/conda/bin/python - "${HOME}" <<'PY'
import errno
import fcntl
import json
import os
import secrets
import stat
import sys

home = sys.argv[1]
if not home or not os.path.isabs(home):
    raise SystemExit(0)

O_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
O_FILE = os.O_RDONLY | os.O_NOFOLLOW


def open_dir_nofollow(parent_fd, name):
    try:
        return os.open(name, O_DIR, dir_fd=parent_fd)
    except OSError as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return None
        if exc.errno == errno.ELOOP:
            print(
                f"[jupyter-env] skipping page_config.json migration: symlinked directory {name!r}",
                file=sys.stderr,
            )
            return None
        print(
            f"[jupyter-env] skipping page_config.json migration: cannot open {name!r}: {exc}",
            file=sys.stderr,
        )
        return None


home_fd = None
jupyter_fd = None
dir_fd = None
cfg_fd = None
try:
    try:
        home_fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    except OSError:
        raise SystemExit(0)

    jupyter_fd = open_dir_nofollow(home_fd, ".jupyter")
    if jupyter_fd is None:
        raise SystemExit(0)

    dir_fd = open_dir_nofollow(jupyter_fd, "labconfig")
    if dir_fd is None:
        raise SystemExit(0)

    try:
        fcntl.flock(dir_fd, fcntl.LOCK_EX)
    except OSError as exc:
        print(
            f"[jupyter-env] skipping page_config.json migration: lock failed: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(0)

    try:
        cfg_fd = os.open("page_config.json", O_FILE, dir_fd=dir_fd)
    except OSError as exc:
        if exc.errno == errno.ENOENT:
            raise SystemExit(0)
        if exc.errno == errno.ELOOP:
            print(
                "[jupyter-env] skipping page_config.json migration: page_config.json is a symlink",
                file=sys.stderr,
            )
            raise SystemExit(0)
        print(
            f"[jupyter-env] skipping page_config.json migration: cannot open page_config.json: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(0)

    st = os.fstat(cfg_fd)
    if not stat.S_ISREG(st.st_mode):
        print(
            "[jupyter-env] skipping page_config.json migration: page_config.json is not a regular file",
            file=sys.stderr,
        )
        raise SystemExit(0)

    with os.fdopen(cfg_fd, "r", encoding="utf-8") as fh:
        cfg_fd = None
        raw = fh.read()

    try:
        payload = json.loads(raw)
    except ValueError as exc:
        print(
            f"[jupyter-env] skipping page_config.json migration: invalid JSON: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(0)

    if not isinstance(payload, dict):
        raise SystemExit(0)

    # Gate strictly on legacy neurodesktop's page_config signature so a user who
    # deliberately disabled @jupyterhub/jupyter-server-proxy in scidesktop keeps
    # their setting.
    if "neurodeskSupporter" not in payload:
        raise SystemExit(0)

    disabled = payload.get("disabledExtensions")
    if not isinstance(disabled, dict) or disabled.get("@jupyterhub/jupyter-server-proxy") is not True:
        raise SystemExit(0)

    disabled.pop("@jupyterhub/jupyter-server-proxy", None)
    if not disabled:
        payload.pop("disabledExtensions", None)
    payload.pop("neurodeskSupporter", None)

    rendered = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    mode = stat.S_IMODE(st.st_mode)
    tmp_name = f".page_config.{os.getpid()}.{secrets.token_hex(6)}.tmp"
    tmp_fd = os.open(
        tmp_name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        mode,
        dir_fd=dir_fd,
    )
    try:
        with os.fdopen(tmp_fd, "w", encoding="utf-8") as out:
            out.write(rendered)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(tmp_name, mode, dir_fd=dir_fd)

        # Verify no concurrent writer replaced or modified page_config.json.
        cur = os.stat("page_config.json", dir_fd=dir_fd, follow_symlinks=False)
        if (
            cur.st_dev != st.st_dev
            or cur.st_ino != st.st_ino
            or cur.st_mtime_ns != st.st_mtime_ns
            or cur.st_size != st.st_size
        ):
            print(
                "[jupyter-env] skipping page_config.json migration: file changed concurrently",
                file=sys.stderr,
            )
            os.unlink(tmp_name, dir_fd=dir_fd)
            raise SystemExit(0)

        os.replace(tmp_name, "page_config.json", src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        print("[jupyter-env] re-enabled @jupyterhub/jupyter-server-proxy in ~/.jupyter/labconfig/page_config.json")
    except OSError as exc:
        print(
            f"[jupyter-env] skipping page_config.json migration: write failed: {exc}",
            file=sys.stderr,
        )
        try:
            os.unlink(tmp_name, dir_fd=dir_fd)
        except OSError:
            pass
finally:
    for fd in (cfg_fd, dir_fd, jupyter_fd, home_fd):
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
PY
exit 0
