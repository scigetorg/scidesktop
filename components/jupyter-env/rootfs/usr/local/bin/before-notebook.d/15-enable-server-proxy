#!/bin/bash
# Re-enables @jupyterhub/jupyter-server-proxy in ~/.jupyter/labconfig/page_config.json
# when a previous image (such as legacy neurodesktop) disabled it there.
# scidesktop relies on jupyter-server-proxy to show the Desktop, VS Code,
# scigent.ai (T3 Code) and desktop-application launcher tiles.
set -u

fix='
import json, os, stat, sys, tempfile
from pathlib import Path

cfg = Path(sys.argv[1]) / ".jupyter" / "labconfig" / "page_config.json"
try:
    st = cfg.lstat()
except OSError:
    raise SystemExit(0)
if not stat.S_ISREG(st.st_mode):
    raise SystemExit(0)

try:
    payload = json.loads(cfg.read_text(encoding="utf-8"))
except (OSError, ValueError):
    raise SystemExit(0)
if not isinstance(payload, dict):
    raise SystemExit(0)

disabled = payload.get("disabledExtensions")
if not isinstance(disabled, dict) or disabled.get("@jupyterhub/jupyter-server-proxy") is not True:
    raise SystemExit(0)

disabled.pop("@jupyterhub/jupyter-server-proxy", None)
if not disabled:
    payload.pop("disabledExtensions", None)

try:
    fd, tmp = tempfile.mkstemp(prefix=".page_config.", dir=str(cfg.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(payload, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.chmod(tmp, stat.S_IMODE(st.st_mode))
        os.replace(tmp, cfg)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    print("[jupyter-env] re-enabled @jupyterhub/jupyter-server-proxy in ~/.jupyter/labconfig/page_config.json")
except OSError:
    pass
'

if [ "$(id -u)" -eq 0 ]; then
    user="${NB_USER:-jovyan}"
    home="$(getent passwd "${user}" | cut -d: -f6)"
    runuser -u "${user}" -- /opt/conda/bin/python -c "${fix}" "${home}"
else
    /opt/conda/bin/python -c "${fix}" "${HOME}"
fi
exit 0
