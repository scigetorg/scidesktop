#!/bin/bash
# Regenerates the locks, which the build installs without solving:
#   linux-64.lock, linux-aarch64.lock
#                     the environment per architecture, as explicit conda
#                     package lists (../conda-lock)
#   requirements.lock packages only on PyPI (requirements.in), with hashes and
#                     without dependencies: those come from the conda lock
#
#   ./lock
set -euo pipefail
cd "$(dirname "$0")"
../conda-lock .
python_version=$(grep -o '/python-3\.[0-9]*' linux-64.lock | head -1 | cut -d- -f2)
# --universal: one lock for every architecture. Each pin carries the hashes of
# all its files, so the hashed install is exact whichever wheel it picks.
uv pip compile requirements.in --quiet --generate-hashes --no-header --no-deps \
    --python-version "${python_version}" --universal \
    --output-file requirements.lock
sed -i '1i # Generated by ./lock from requirements.in. Do not edit.' requirements.lock
echo "requirements.lock: $(grep -c '==' requirements.lock) packages"
