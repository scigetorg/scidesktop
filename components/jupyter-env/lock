#!/bin/bash
# Regenerates both locks, which the build installs without solving:
#   linux-64.lock     the environment, as an explicit conda package list
#   requirements.lock packages only on PyPI (requirements.in), with hashes and
#                     without dependencies: those come from the conda lock
#
#   ./lock
set -euo pipefail
cd "$(dirname "$0")"
MICROMAMBA_VERSION=$(sed -n 's/^variable "MICROMAMBA_VERSION" { default = "\(.*\)" }$/\1/p' ../../docker-bake.hcl)
[ -n "${MICROMAMBA_VERSION}" ] || { echo "MICROMAMBA_VERSION not found in docker-bake.hcl" >&2; exit 1; }
UBUNTU=$(sed -n 's/^variable "UBUNTU" { default = "\(.*\)" }$/\1/p' ../../docker-bake.hcl)
docker run --rm -v "${PWD}:/work" -w /work "docker.io/library/ubuntu:${UBUNTU}" bash -euo pipefail -c "
    apt-get update -qq >/dev/null && apt-get install -qq -y curl ca-certificates bzip2 >/dev/null
    curl -fsSL -o /usr/local/bin/micromamba \
        https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-linux-64
    chmod +x /usr/local/bin/micromamba
    micromamba create --yes --quiet --root-prefix /tmp/root --prefix /tmp/env \
        --platform linux-64 --file environment.yml >/dev/null
    {
        echo '# Generated by ./lock from environment.yml. Do not edit.'
        micromamba env export --root-prefix /tmp/root --prefix /tmp/env --explicit --md5 \
            | grep -v '^#'
    } > linux-64.lock
    chown \$(stat -c %u:%g environment.yml) linux-64.lock
"
python_version=$(grep -o '/python-3\.[0-9]*' linux-64.lock | head -1 | cut -d- -f2)
uv pip compile requirements.in --quiet --generate-hashes --no-header --no-deps \
    --python-version "${python_version}" --python-platform x86_64-manylinux_2_28 \
    --output-file requirements.lock
sed -i '1i # Generated by ./lock from requirements.in. Do not edit.' requirements.lock
echo "linux-64.lock: $(grep -c '^https' linux-64.lock) packages; requirements.lock: $(grep -c '==' requirements.lock) packages"
