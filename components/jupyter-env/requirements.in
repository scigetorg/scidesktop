# Jupyter extensions installed from PyPI without dependencies:
# everything they need must be in environment.yml (jupyterlmod: jupyter-core,
# jupyter-server; bash_kernel: ipykernel, pexpect — installed via PyPI so
# conda-forge's bash package does not shadow /bin/bash and bypass /etc/bash.bashrc).
# Run ./lock after changing a pin.
