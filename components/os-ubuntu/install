#!/bin/bash
# Installs the OS layer. Run by the Dockerfile with this script and packages/
# mounted under /tmp/os-ubuntu and the build arguments in the environment.
set -euo pipefail
HERE=/tmp/os-ubuntu
: "${APT_SNAPSHOT:?}" "${CVMFS_VERSION:?}" "${CVMFS_CONFIG_VERSION:?}"
: "${TARGETARCH:?}" "${NB_USER:?}" "${NB_UID:?}" "${NB_GID:?}"
# First, so an unsupported architecture stops before anything is downloaded.
deb_arch="$(target-arch deb)"

echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries
# The build caches /var/cache/apt; the image's docker-clean hook would empty it.
rm -f /etc/apt/apt.conf.d/docker-clean

# Packages come from a dated snapshot. The live sources are kept beside it and
# restored by the Dockerfile's runtime "os" stage, so apt at runtime sees the
# live archive.
sources=/etc/apt/sources.list.d/ubuntu.sources
cp "${sources}" "${sources}.live"
# The snapshot service has every architecture under /ubuntu, including the
# ones the live archive serves from ports.ubuntu.com/ubuntu-ports.
sed -i -E "s#^URIs: https?://((archive|security)\.ubuntu\.com/ubuntu|ports\.ubuntu\.com/ubuntu-ports)/?#URIs: https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT}#" "${sources}"
grep -q "snapshot.ubuntu.com" "${sources}"

apt_get() { apt-get -o Acquire::https::CAInfo=/tmp/bootstrap-ca.crt "$@"; }
# Any index that fails to download (after the retries above) fails the build;
# by default apt only warns and installs from whatever indexes it got.
apt_get update -o APT::Update::Error-Mode=any
apt_get upgrade --yes
# shellcheck disable=SC2046
apt_get install --yes --no-install-recommends \
    $(sed -e 's/#.*//' "${HERE}"/packages/*.txt | tr -s '[:space:]' ' ')

# CVMFS client from CERN's packages for this release and architecture,
# SHA-256 verified before installation.
. /etc/os-release
arch_upper="${TARGETARCH^^}"
cvmfs_tmp=$(mktemp -d)
for p in cvmfs cvmfs-libs cvmfs-fuse3; do
    case "${p}" in
        cvmfs)       sha_var="CVMFS_SHA256_${arch_upper}" ;;
        cvmfs-libs)  sha_var="CVMFS_LIBS_SHA256_${arch_upper}" ;;
        cvmfs-fuse3) sha_var="CVMFS_FUSE3_SHA256_${arch_upper}" ;;
    esac
    fetch \
        "https://ecsft.cern.ch/dist/cvmfs/cvmfs-${CVMFS_VERSION}/${p}_${CVMFS_VERSION}+ubuntu${VERSION_ID}_${deb_arch}.deb" \
        "${!sha_var:?missing ${sha_var}}" \
        "${cvmfs_tmp}/${p}.deb"
done
fetch \
    "https://ecsft.cern.ch/dist/cvmfs/cvmfs-config/cvmfs-config-none_${CVMFS_CONFIG_VERSION}_all.deb" \
    "${CVMFS_CONFIG_NONE_SHA256:?}" \
    "${cvmfs_tmp}/cvmfs-config-none.deb"
apt_get install --yes --no-install-recommends "${cvmfs_tmp}"/*.deb
rm -rf "${cvmfs_tmp}"
# Debug-instrumented CVMFS libraries (~32 MB) are unused at runtime.
rm -f /usr/lib/libcvmfs_*_debug.so*
# vim-tiny installs /usr/bin/vim.tiny and registers vi; provide vim as well.
if [ -x /usr/bin/vim.tiny ] && [ ! -e /usr/bin/vim ]; then
    ln -s /usr/bin/vim.tiny /usr/bin/vim
fi
cvmfs2 --version

# Locales, as docker-stacks generates them.
printf '%s\n' "en_US.UTF-8 UTF-8" "C.UTF-8 UTF-8" > /etc/locale.gen
locale-gen
rm -rf /usr/bin/pebble /var/lib/pebble

# Notebook user. The image ships a default user on UID 1000; it is removed so
# the notebook user can take that UID.
if id -un "${NB_UID}" >/dev/null 2>&1; then
    userdel --remove "$(id -un "${NB_UID}")"
fi
echo "auth requisite pam_deny.so" >> /etc/pam.d/su
sed -i 's/^#force_color_prompt=yes/force_color_prompt=yes/' /etc/skel/.bashrc
# Do not overwrite PS1 set by /etc/bash.bashrc.d/startup.sh when SCIDESKTOP_FLAVOUR is set.
sed -i -E \
    -e 's|^if \[ "\$color_prompt" = yes \]; then$|if [ -n "${SCIDESKTOP_FLAVOUR:-}" ]; then\n    :\nelif [ "$color_prompt" = yes ]; then|' \
    -e 's|^case "\$TERM" in$|if [ -z "${SCIDESKTOP_FLAVOUR:-}" ]; then\ncase "$TERM" in|' \
    /etc/skel/.bashrc
# Close the guard around the xterm title block (only the second `case "$TERM"` block in /etc/skel/.bashrc).
awk '
    /^if \[ -z "\$\{SCIDESKTOP_FLAVOUR:-\}" \]; then$/ { in_guard = 1 }
    { print }
    in_guard && /^esac$/ { print "fi"; in_guard = 0 }
' /etc/skel/.bashrc > /etc/skel/.bashrc.tmp
mv /etc/skel/.bashrc.tmp /etc/skel/.bashrc
grep -q 'SCIDESKTOP_FLAVOUR' /etc/skel/.bashrc
bash -n /etc/skel/.bashrc
useradd --no-log-init --create-home --shell /bin/bash --uid "${NB_UID}" \
    --gid "${NB_GID}" --no-user-group "${NB_USER}"
# start.sh registers unknown UIDs in /etc/passwd under Kubernetes foreign-UID
# deployments (--user <uid>:0, required by PostgreSQL initdb in datadesktop).
# Safe because every SUID/SGID bit and POSIX file capability is stripped below
# and start.sh locks NoNewPrivs=1.
chmod g+w /etc/passwd
find / -xdev \( -perm -4000 -o -perm -2000 \) -type f -exec chmod u-s,g-s {} +
while IFS= read -r -d '' f; do
    if getfattr -n security.capability --only-values "${f}" >/dev/null 2>&1; then
        setfattr -x security.capability "${f}"
    fi
done < <(find / -xdev -type f -perm /111 -print0)
install -d -o "${NB_UID}" -g "${NB_GID}" "/home/${NB_USER}/.cache" "/home/${NB_USER}/work"

# Interactive bash sources drop-in snippets from components (Lmod, mamba).
install -d -m 0755 /etc/bash.bashrc.d
printf '%s\n' '' '# Drop-in snippets from image components.' \
    'for f in /etc/bash.bashrc.d/*.sh; do [ -r "${f}" ] && . "${f}"; done; unset f' \
    >> /etc/bash.bashrc

# This layer's entry in the image's version manifest.
install -d -m 0755 /opt/scidesktop/manifest.d
printf '{"id": "%s", "version": "%s", "arch": "%s", "package_snapshot": "%s", "cvmfs": "%s"}\n' \
    "${ID}" "${VERSION_ID}" "$(target-arch uname)" "${APT_SNAPSHOT}" "${CVMFS_VERSION}" \
    > /opt/scidesktop/manifest.d/os-ubuntu.json
