# Taskbar buttons. Applications start from JupyterLab's launcher tiles; these
# open sciget's text interface, the file manager and a terminal.
# Use explicit SVG paths: bare icon names like utilities-terminal and
# system-file-manager are symbolic-only in Ubuntu 26.04's Adwaita theme and
# render blank in IceWM.
prog "Apps (sciget)" /usr/share/icons/hicolor/scalable/apps/sciget.svg xfce4-terminal --title=Apps -x sciget
prog "Files" /usr/share/icons/Adwaita/scalable/places/folder.svg thunar
prog "Terminal" /usr/share/icons/hicolor/scalable/apps/org.xfce.terminal.svg xfce4-terminal
