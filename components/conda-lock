#!/bin/bash
# Solves a component's environment.yml for every supported architecture and
# writes one explicit lock per architecture beside it (linux-64.lock,
# linux-aarch64.lock), which the build installs without solving. Run through
# the component's ./lock.
#
#   conda-lock <component folder>
#
# Nothing is installed, so one machine locks every architecture.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
cd "${1:?usage: conda-lock <component folder>}"
bake="${here}/../docker-bake.hcl"
MICROMAMBA_VERSION=$(sed -n 's/^variable "MICROMAMBA_VERSION" { default = "\(.*\)" }$/\1/p' "${bake}")
[ -n "${MICROMAMBA_VERSION}" ] || { echo "MICROMAMBA_VERSION not found in docker-bake.hcl" >&2; exit 1; }
UBUNTU=$(sed -n 's/^variable "UBUNTU" { default = "\(.*\)" }$/\1/p' "${bake}")
# The architecture the container below runs on, in Docker's own naming.
host=$(TARGETARCH="$(docker version --format '{{.Server.Arch}}')" "${here}/target-arch" conda)
platforms=()
for arch in $("${here}/target-arch" list); do
    platforms+=("$(TARGETARCH="${arch}" "${here}/target-arch" conda)")
done
docker run --rm -v "${PWD}:/work" -w /work "docker.io/library/ubuntu:${UBUNTU}" bash -euo pipefail -c "
    apt-get update -qq >/dev/null && apt-get install -qq -y curl ca-certificates jq >/dev/null 2>&1
    curl -fsSL -o /usr/local/bin/micromamba \
        https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-${host}
    chmod +x /usr/local/bin/micromamba
    for platform in ${platforms[*]}; do
        micromamba create --yes --dry-run --json --root-prefix /tmp/root --prefix /tmp/env \
            --platform \"\${platform}\" --file environment.yml > /tmp/solve.json
        {
            echo '# Generated by ./lock from environment.yml. Do not edit.'
            echo '@EXPLICIT'
            jq -er '.actions.LINK[] | \"\(.url)#\(.md5)\"' /tmp/solve.json
        } > \"\${platform}.lock\"
        chown \$(stat -c %u:%g environment.yml) \"\${platform}.lock\"
    done
"
for platform in "${platforms[@]}"; do
    echo "${platform}.lock: $(grep -c '^https' "${platform}.lock") packages"
done
