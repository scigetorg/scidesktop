// Shared Nextflow profiles for scidesktop sessions.
//
// scidesktop runs rootless Apptainer (no Docker daemon) and a single-node
// session Slurm queue. Pass this file with `-c` when running Viash Hub,
// OpenPipelines, nf-core, or custom Nextflow pipelines:
//
//   nextflow run <pipeline> -c /etc/scidesktop/nextflow/scidesktop.config -profile apptainer
//   nextflow run <pipeline> -c /etc/scidesktop/nextflow/scidesktop.config -profile apptainer,slurm
//   nextflow run <pipeline> -c /etc/scidesktop/nextflow/scidesktop.config -profile scidesktop

profiles {
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${System.getenv('XDG_CACHE_HOME') ?: "${System.getenv('HOME') ?: '/tmp'}/.cache"}/nextflow/apptainer"
        docker.enabled       = false
        singularity.enabled  = false
        podman.enabled       = false
        shifter.enabled      = false
        charliecloud.enabled = false
    }
    slurm {
        process.executor                  = 'slurm'
        process.queue                     = 'scidesktop'
        executor.$slurm.queueStatInterval = '5 sec'
        executor.$slurm.pollInterval      = '5 sec'
    }
    scidesktop {
        apptainer.enabled                 = true
        apptainer.autoMounts              = true
        apptainer.cacheDir                = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${System.getenv('XDG_CACHE_HOME') ?: "${System.getenv('HOME') ?: '/tmp'}/.cache"}/nextflow/apptainer"
        docker.enabled                    = false
        singularity.enabled               = false
        podman.enabled                    = false
        shifter.enabled                   = false
        charliecloud.enabled              = false
        process.executor                  = 'slurm'
        process.queue                     = 'scidesktop'
        executor.$slurm.queueStatInterval = '5 sec'
        executor.$slurm.pollInterval      = '5 sec'
    }
}
