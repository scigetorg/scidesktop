#!/bin/bash
# Regenerates requirements.lock against jupyter-env's Python minor version,
# constraining every shared package to the exact version in jupyter-env's
# amd64 and arm64 locks and omitting only packages already provided by both.
set -euo pipefail
cd "$(dirname "$0")"
python_version=$(grep -o '/python-3\.[0-9]*' ../jupyter-env/linux-64.lock | head -1 | cut -d- -f2)

tmp_dir=$(mktemp -d)
trap 'rm -rf "${tmp_dir}"' EXIT

python3 - "${tmp_dir}/constraints.txt" "${tmp_dir}/exclude.txt" <<'PY'
import pathlib, re, sys

constraints_path = pathlib.Path(sys.argv[1])
exclude_path = pathlib.Path(sys.argv[2])

# Known conda->PyPI package name aliases in jupyter-env.
ALIASES = {
    "python-fastjsonschema": "fastjsonschema",
    "python-tzdata": "tzdata",
    "bleach-with-css": "bleach",
    "jsonschema-with-format-nongpl": "jsonschema",
    "nbconvert-core": "nbconvert",
}

def parse_conda_lock(path):
    pkgs = {}
    for line in path.read_text().splitlines():
        if not line.startswith("https://"):
            continue
        fn = line.rsplit("/", 1)[-1].split("#")[0]
        parts = fn.rsplit("-", 2)
        if len(parts) != 3:
            continue
        name, ver, _ = parts
        norm = name.lower().replace("_", "-")
        if not norm or not norm[0].isalnum():
            continue
        pkgs[norm] = ver
        if norm in ALIASES:
            pkgs.setdefault(ALIASES[norm], ver)
    return pkgs

amd64 = parse_conda_lock(pathlib.Path("../jupyter-env/linux-64.lock"))
arm64 = parse_conda_lock(pathlib.Path("../jupyter-env/linux-aarch64.lock"))

# Pip overrides in jupyter-env win over conda versions on both architectures.
pip_pkgs = {}
for line in pathlib.Path("../jupyter-env/requirements.lock").read_text().splitlines():
    m = re.match(r"^([A-Za-z0-9_.-]+)==([^ ;\\]+)", line)
    if m:
        pip_pkgs[m.group(1).lower().replace("_", "-")] = m.group(2)

shared = {}
for name in sorted((set(amd64) & set(arm64)) | set(pip_pkgs)):
    if name in pip_pkgs:
        shared[name] = pip_pkgs[name]
    elif amd64[name] == arm64[name]:
        shared[name] = amd64[name]

# Valid PEP 440 versions become exact uv constraints so resolution fails loudly
# if any notebook-intelligence dependency conflicts with jupyter-env.
pep440 = re.compile(r"^[0-9]+(\.[0-9]+)*([a-z]+[0-9]+)?(\.post[0-9]+)?(\.dev[0-9]+)?$")
constraints = [f"{k}=={v}" for k, v in sorted(shared.items()) if pep440.match(v)]
constraints_path.write_text("\n".join(constraints) + "\n")
exclude_path.write_text("\n".join(sorted(shared)) + "\n")
PY

mapfile -t exclude_args < <(while IFS= read -r pkg; do
    [ -n "${pkg}" ] || continue
    printf '%s\n%s\n' "--no-emit-package" "${pkg}"
done < "${tmp_dir}/exclude.txt")

uv pip compile requirements.in --quiet --generate-hashes --no-header \
    --python-version "${python_version}" --universal \
    --constraint "${tmp_dir}/constraints.txt" \
    "${exclude_args[@]}" \
    --output-file requirements.lock
sed -i '1i # Generated by ./lock from requirements.in. Do not edit.' requirements.lock
echo "requirements.lock: $(grep -c '==' requirements.lock) packages"
