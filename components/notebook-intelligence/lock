#!/bin/bash
# Regenerates requirements.lock against jupyter-env's Python minor version,
# omitting packages already provided by jupyter-env so /opt/notebook-intelligence/lib
# carries only the delta.
set -euo pipefail
cd "$(dirname "$0")"
python_version=$(grep -o '/python-3\.[0-9]*' ../jupyter-env/linux-64.lock | head -1 | cut -d- -f2)

mapfile -t exclude_args < <(python3 - <<'PY'
import pathlib, re

pkgs = set()
for line in pathlib.Path("../jupyter-env/linux-64.lock").read_text().splitlines():
    if line.startswith("https://"):
        fn = line.rsplit("/", 1)[-1].split("#")[0]
        parts = fn.rsplit("-", 2)
        if len(parts) == 3:
            p = parts[0].lower().replace("_", "-")
            if p and p[0].isalnum():
                pkgs.add(p)
                if p.startswith("python-"):
                    pkgs.add(p.removeprefix("python-"))
for line in pathlib.Path("../jupyter-env/requirements.lock").read_text().splitlines():
    m = re.match(r"^([A-Za-z0-9_.-]+)==", line)
    if m:
        pkgs.add(m.group(1).lower().replace("_", "-"))

for p in sorted(pkgs):
    print("--no-emit-package")
    print(p)
PY
)

uv pip compile requirements.in --quiet --generate-hashes --no-header \
    --python-version "${python_version}" --universal \
    "${exclude_args[@]}" \
    --output-file requirements.lock
sed -i '1i # Generated by ./lock from requirements.in. Do not edit.' requirements.lock
echo "requirements.lock: $(grep -c '==' requirements.lock) packages"
