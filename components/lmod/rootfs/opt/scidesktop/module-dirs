#!/bin/sh
# Prints the module folders components add to MODULEPATH, one per line, in
# order: each executable in /etc/scidesktop/modulepath.d, in name order, run
# as the current user. Used by every shell (/etc/profile.d/z01_lmod_modulepath.sh)
# and the Jupyter server (before-notebook.d/35-lmod-modulepath.sh).
for f in /etc/scidesktop/modulepath.d/*; do
    [ -x "${f}" ] && "${f}" 2>/dev/null
done
exit 0
