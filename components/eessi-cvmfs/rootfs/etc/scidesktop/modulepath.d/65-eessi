#!/bin/sh
# Exposes the EESSI Lmod module root (/cvmfs/software.eessi.io/init/modules)
# when CVMFS is enabled and /cvmfs/software.eessi.io is mounted. Listing the
# folder first triggers autofs where CVMFS is mounted on demand.
[ "${SCIDESKTOP_CVMFS_MODE:-external}" = disabled ] && exit 0
root=/cvmfs/software.eessi.io/init/modules
ls "${root}" >/dev/null 2>&1 || exit 0
echo "${root}"
exit 0
