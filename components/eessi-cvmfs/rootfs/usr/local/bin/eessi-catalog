#!/bin/bash
# Manage and inspect EESSI software catalogs and desktop launchers for scidesktop.
#
#   eessi-catalog [list]           Show mount status, desktop launchers, and curated tools
#   eessi-catalog sync             Fetch live <domain>/eessi.json catalogs and generate launchers
#   eessi-catalog urls             Print resolved EESSI catalog URLs or local files
#   eessi-catalog apps-dir         Print active EESSI .desktop snapshot directory
#   eessi-catalog session-apps-dir Stage a container-local copy of active launchers for JupyterLab
#   eessi-catalog json             Print merged cached EESSI catalog JSON
#
# Environment overrides:
#   EESSI_CACHE_DIR        Cache directory (default: ${XDG_CACHE_HOME:-$HOME/.cache}/scidesktop/eessi)
#   EESSI_CATALOG_FILES    Colon-separated local eessi.json files (disables network)
#   EESSI_CATALOG_URLS     Comma- or space-separated HTTPS eessi.json URLs
#   SCIGET_CATALOGS_FILE   sciget catalogs.json path (default: /etc/sciget/catalogs.json)
#   EESSI_MODULE_ROOT      EESSI Lmod root (default: /cvmfs/software.eessi.io/init/modules)
set -euo pipefail

DEFAULT_EESSI_CATALOG_URL="https://apps-catalog.scigetorg.workers.dev/eessi/catalog.json"
STATIC_APPS_DIR="${EESSI_STATIC_APPS_DIR:-/etc/scidesktop/eessi-apps.d}"
STATIC_CATALOG_DIR="${EESSI_STATIC_CATALOG_DIR:-/etc/scidesktop/eessi-catalog.d}"
CATALOGS_FILE="${SCIGET_CATALOGS_FILE:-/etc/sciget/catalogs.json}"
CACHE_DIR="${EESSI_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME}/.cache}/scidesktop/eessi}"
CONNECT_TIMEOUT="${EESSI_CATALOG_CONNECT_TIMEOUT:-3}"
MAX_TIME="${EESSI_CATALOG_TIMEOUT:-6}"
MAX_BYTES="${EESSI_CATALOG_MAX_BYTES:-5242880}"
STAGING_DIR=""
STAGE_LOCK_FD=""

cleanup_staging() {
    if [ -n "${STAGE_LOCK_FD}" ]; then
        exec {STAGE_LOCK_FD}>&- 2>/dev/null || true
        STAGE_LOCK_FD=""
    fi
    if [ -n "${STAGING_DIR}" ]; then
        rm -rf "${STAGING_DIR}"
        STAGING_DIR=""
    fi
}
trap cleanup_staging EXIT

usage() {
    cat >&2 <<'EOF'
usage: eessi-catalog [list|sync|refresh|urls|apps-dir|session-apps-dir|json]
EOF
}

resolve_sources() {
    if [ -n "${EESSI_CATALOG_FILES:-}" ]; then
        if [[ "${EESSI_CATALOG_FILES}" == *$'\n'* || "${EESSI_CATALOG_FILES}" == *$'\r'* ]]; then
            echo "eessi-catalog: EESSI_CATALOG_FILES must not contain newlines" >&2
            return 1
        fi
        local -a raw_paths=()
        local -A seen_sources=()
        local path resolved entry
        IFS=':' read -r -a raw_paths <<<"${EESSI_CATALOG_FILES}"
        for path in "${raw_paths[@]}"; do
            [ -n "${path}" ] || continue
            resolved="$(realpath -m -- "${path}" && printf X)" || return 1
            resolved="${resolved%X}"
            resolved="${resolved%$'\n'}"
            if [[ "${resolved}" == *$'\n'* || "${resolved}" == *$'\r'* ]]; then
                echo "eessi-catalog: canonical catalog path must not contain newlines" >&2
                return 1
            fi
            entry="file:${resolved}"
            if [ -z "${seen_sources[${entry}]+x}" ]; then
                seen_sources["${entry}"]=1
                printf '%s\n' "${entry}"
            fi
        done
        return 0
    fi

    if [ -n "${EESSI_CATALOG_URLS:-}" ]; then
        printf '%s\n' "${EESSI_CATALOG_URLS}" \
            | tr ', \t' '\n' \
            | awk 'NF && !seen[$0]++ { print "url:" $0 }'
        return 0
    fi

    if [ -r "${CATALOGS_FILE}" ]; then
        local derived
        derived="$(jq -r '
            if type == "array" then
                .[]
                | select((has("use") | not) or .use == true)
                | (.url // "")
                | select(type == "string" and test("\\Ahttps://[^[:space:]]+/apps\\.json\\z"))
                | sub("/apps\\.json$"; "/eessi.json")
            else
                empty
            end
        ' "${CATALOGS_FILE}" 2>/dev/null | awk 'NF && !seen[$0]++ { print "url:" $0 }')" || true
        if [ -n "${derived}" ]; then
            printf '%s\n' "${derived}"
            return 0
        fi
    fi

    printf 'url:%s\n' "${DEFAULT_EESSI_CATALOG_URL}"
}

namespace_dir_for_sources() {
    local sources="$1"
    local digest
    digest="$(printf '%s\n' "${sources}" | sha256sum | cut -c1-16)"
    printf '%s/by-source/%s\n' "${CACHE_DIR}" "${digest}"
}

cache_matches_sources_for() {
    local expected="$1"
    local ns_dir current_dir
    [ -n "${expected}" ] || return 1
    ns_dir="$(namespace_dir_for_sources "${expected}")"
    current_dir="${ns_dir}/current"
    [ -f "${current_dir}/sources.txt" ] && [ ! -p "${current_dir}/sources.txt" ] \
        && [ -f "${current_dir}/merged.json" ] && [ ! -p "${current_dir}/merged.json" ] || return 1
    [ "$(cat "${current_dir}/sources.txt")" = "${expected}" ]
}

active_apps_dir_for_sources() {
    local expected="$1"
    local ns_dir cached_apps resolved_apps
    if [ -n "${expected}" ] && cache_matches_sources_for "${expected}"; then
        ns_dir="$(namespace_dir_for_sources "${expected}")"
        cached_apps="${ns_dir}/current/applications"
        if [ -d "${cached_apps}" ]; then
            resolved_apps="$(readlink -f -- "${cached_apps}" 2>/dev/null || true)"
            if [ -n "${resolved_apps}" ] && [ -d "${resolved_apps}" ]; then
                local f
                for f in "${resolved_apps}"/*.desktop; do
                    if [ -f "${f}" ]; then
                        printf '%s\n' "${resolved_apps}"
                        return 0
                    fi
                done
            fi
        fi
    fi
    if [ -d "${STATIC_APPS_DIR}" ]; then
        printf '%s\n' "${STATIC_APPS_DIR}"
    fi
}

active_apps_dir() {
    local expected=""
    if ! expected="$(resolve_sources 2>/dev/null)"; then
        expected=""
    fi
    active_apps_dir_for_sources "${expected}"
}

session_apps_dir() {
    local expected="" ns_dir lock_fd="" src_dir session_root session_dir f copied=0
    if ! expected="$(resolve_sources 2>/dev/null)" || [ -z "${expected}" ]; then
        [ -d "${STATIC_APPS_DIR}" ] && printf '%s\n' "${STATIC_APPS_DIR}"
        return 0
    fi
    ns_dir="$(namespace_dir_for_sources "${expected}")"
    if [ -r "${ns_dir}/.lock" ]; then
        exec {lock_fd}<"${ns_dir}/.lock"
        flock -s "${lock_fd}"
    elif [ -d "${ns_dir}" ] && [ -w "${ns_dir}" ]; then
        exec {lock_fd}>>"${ns_dir}/.lock"
        flock -s "${lock_fd}"
    else
        [ -d "${STATIC_APPS_DIR}" ] && printf '%s\n' "${STATIC_APPS_DIR}"
        return 0
    fi

    src_dir="$(active_apps_dir_for_sources "${expected}")"
    if [ -z "${src_dir}" ] || [ "${src_dir}" = "${STATIC_APPS_DIR}" ]; then
        exec {lock_fd}>&-
        [ -n "${src_dir}" ] && printf '%s\n' "${src_dir}"
        return 0
    fi

    session_root="${EESSI_SESSION_APPS_ROOT:-/tmp}"
    mkdir -p "${session_root}"
    session_dir="$(mktemp -d "${session_root}/scidesktop-eessi-apps.XXXXXX")"
    STAGING_DIR="${session_dir}"
    chmod 0755 "${session_dir}"
    for f in "${src_dir}"/*.desktop; do
        [ -f "${f}" ] || continue
        cp -- "${f}" "${session_dir}/"
        chmod 0644 "${session_dir}/$(basename "${f}")"
        copied=$((copied + 1))
    done
    exec {lock_fd}>&-

    if [ "${copied}" -eq 0 ]; then
        cleanup_staging
        if [ -d "${STATIC_APPS_DIR}" ]; then
            printf '%s\n' "${STATIC_APPS_DIR}"
        fi
        return 0
    fi
    STAGING_DIR=""
    printf '%s\n' "${session_dir}"
}

validate_catalog_json() {
    local file="$1"
    # Slurp (-s) and assert length == 1 so trailing or multi-document streams
    # cannot bypass validation. Use \A...\z so Oniguruma never accepts a
    # trailing newline inside validated identifiers or exec arguments, and
    # forbid NUL bytes in all free-text fields.
    jq -es '
        length == 1
        and (.[0] | (
            type == "object"
            and .schemaVersion == 1
            and .backend == "eessi"
            and .explicitSelectionRequired == true
            and (.cvmfsRepo | type == "string" and test("\\A[a-z0-9][a-z0-9.-]*\\.[a-z]{2,}\\z"))
            and (.stacks | type == "array" and length > 0 and all(.[]; type == "string" and test("\\A[0-9]{4}\\.[0-9]{2}\\z")))
            and (.tools | type == "object")
            and ((.tools | keys) | all(.[]; test("\\A[a-z0-9][a-z0-9._+-]{0,63}\\z")))
            and (
                [.tools | to_entries[] | .value]
                | all(.[];
                    type == "object"
                    and (.package | type == "string" and length > 0 and test("\\S") and (contains("\u0000") | not) and (test("[[:cntrl:]]") | not))
                    and (.categories | type == "array" and all(.[]; type == "string" and (contains("\u0000") | not) and (test("[[:cntrl:]]") | not)))
                    and ((.description == null) or (.description | type == "string" and (contains("\u0000") | not)))
                    and ((.homepage == null) or (.homepage | type == "string" and (contains("\u0000") | not)))
                    and (.apps | type == "object")
                    and ((.apps | keys) | all(.[]; length > 0 and test("\\S") and (contains("\u0000") | not) and (test("[[:cntrl:]]") | not)))
                    and (
                        [.apps | to_entries[] | .value]
                        | all(.[];
                            type == "object"
                            and .backend == "eessi"
                            and (.stack | type == "string" and test("\\A[0-9]{4}\\.[0-9]{2}\\z"))
                            and (.module | type == "string" and test("\\A[A-Za-z0-9][A-Za-z0-9._+-]*/[A-Za-z0-9][A-Za-z0-9._+-]*\\z"))
                            and (.exec | type == "array" and all(.[]; type == "string" and test("\\A[A-Za-z0-9._/@:+=-]{1,128}\\z")))
                            and ((.gpu == null) or (.gpu | type == "boolean"))
                            and ((.gui == null) or (.gui | type == "boolean"))
                            and ((.terminal == null) or (.terminal | type == "boolean"))
                            and ((.show_in_menu == null) or (.show_in_menu | type == "boolean"))
                            and (if (.show_in_menu // false) then (.exec | length > 0) else true end)
                        )
                    )
                )
            )
        ))
    ' "${file}" >/dev/null 2>&1
}

desktop_slug() {
    local id="$1"
    case "${id}" in
        r-bundle-cran) printf 'r-cran' ;;
        r-bundle-bioconductor) printf 'r-bioconductor' ;;
        *) printf '%s' "${id}" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//' ;;
    esac
}

sanitize_desktop_value() {
    printf '%s' "$1" | tr '\r\n\t' '   ' | tr -d '\000-\037\177' | sed -E 's/  +/ /g; s/^ //; s/ $//'
}

sanitize_terminal_title() {
    printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._+()/-' | sed -E 's/  +/ /g; s/^ //; s/ $//'
}

desktop_categories() {
    local cats_csv="$1"
    local out="Science;"
    case ",${cats_csv}," in
        *,visualization,*|*,image\ segmentation,*) out="${out}Graphics;" ;;
    esac
    case ",${cats_csv}," in
        *,statistics,*) out="${out}Math;" ;;
    esac
    case ",${cats_csv}," in
        *,molecular\ biology,*) out="${out}Biology;" ;;
    esac
    case ",${cats_csv}," in
        *,programming,*) out="${out}Development;" ;;
    esac
    printf '%s' "${out}"
}

decode_b64() {
    printf '%s' "$1" | base64 -d
}

sync_catalogs() {
    local sources
    sources="$(resolve_sources)"
    if [ -z "${sources}" ]; then
        echo "eessi-catalog: no EESSI catalog sources configured" >&2
        return 1
    fi

    local ns_dir
    ns_dir="$(namespace_dir_for_sources "${sources}")"
    mkdir -p "${ns_dir}/snapshots"

    local stage
    stage="$(mktemp -d "${ns_dir}/snapshots/.staging.XXXXXX")"
    STAGING_DIR="${stage}"
    exec {STAGE_LOCK_FD}>"${stage}/.in-use"
    flock -x "${STAGE_LOCK_FD}"
    chmod 0755 "${stage}"
    mkdir -p "${stage}/catalogs" "${stage}/applications"
    chmod 0755 "${stage}/catalogs" "${stage}/applications"

    local idx=0
    local src kind target dest
    local -a fetched_files=()
    while IFS= read -r src; do
        [ -n "${src}" ] || continue
        kind="${src%%:*}"
        target="${src#*:}"
        idx=$((idx + 1))
        dest="${stage}/catalogs/$(printf '%02d' "${idx}").json"
        if [ "${kind}" = "file" ]; then
            if [ ! -r "${target}" ]; then
                echo "eessi-catalog: cannot read catalog file: ${target}" >&2
                return 1
            fi
            cp -- "${target}" "${dest}"
        elif [ "${kind}" = "url" ]; then
            if [[ ! "${target}" =~ ^https://[^[:space:]]+$ ]]; then
                echo "eessi-catalog: refusing non-HTTPS catalog URL: ${target}" >&2
                return 1
            fi
            if ! curl -fsSL --proto '=https' --tlsv1.2 \
                --connect-timeout "${CONNECT_TIMEOUT}" \
                --max-time "${MAX_TIME}" \
                --max-filesize "${MAX_BYTES}" \
                -o "${dest}" "${target}"; then
                echo "eessi-catalog: failed to fetch ${target}" >&2
                return 1
            fi
        else
            echo "eessi-catalog: invalid source: ${src}" >&2
            return 1
        fi
        if ! validate_catalog_json "${dest}"; then
            echo "eessi-catalog: invalid EESSI catalog JSON from ${target}" >&2
            return 1
        fi
        chmod 0644 "${dest}"
        fetched_files+=("${dest}")
    done <<<"${sources}"

    if [ "${#fetched_files[@]}" -eq 0 ]; then
        echo "eessi-catalog: no EESSI catalogs loaded" >&2
        return 1
    fi

    printf '%s\n' "${sources}" > "${stage}/sources.txt"
    chmod 0644 "${stage}/sources.txt"

    # Merge validated catalogs deterministically across all configured domains.
    jq -s '
        {
            schemaVersion: 1,
            backend: "eessi",
            explicitSelectionRequired: true,
            cvmfsRepo: (.[0].cvmfsRepo),
            stacks: ([.[].stacks[]] | unique | sort | reverse),
            tools: (
                reduce .[] as $doc ({};
                    reduce ($doc.tools | to_entries[]) as $t (.;
                        .[$t.key] = (
                            if has($t.key) then
                                .[$t.key]
                                | .categories = ((.categories + $t.value.categories) | unique | sort)
                                | .apps = (.apps * $t.value.apps)
                            else
                                $t.value
                            end
                        )
                    )
                )
            )
        }
    ' "${fetched_files[@]}" > "${stage}/merged.json"
    chmod 0644 "${stage}/merged.json"

    # Materialize base64-framed launcher records first (9 lines per record, one
    # base64 field per line) so jq errors abort sync and no delimiter character
    # in any field can ever cross field boundaries. Primaries are ordered before
    # secondaries so secondary filenames never steal another tool's canonical slug.
    local launchers_b64="${stage}/launchers.b64"
    jq -r '
        [
            .tools | to_entries[] as $t
            | [
                $t.value.apps | to_entries[] as $a
                | select(
                    ($a.value.show_in_menu // false) == true
                    and (($a.value.exec // []) | length > 0)
                    and (($a.key | gsub("^[[:space:]]+|[[:space:]]+$"; "") | length) > 0)
                  )
                | {
                    id: $t.key,
                    label: $a.key,
                    stack: $a.value.stack,
                    stack_num: ($a.value.stack | split(".") | map(tonumber) | .[0] * 100 + .[1]),
                    module: $a.value.module,
                    gpu: ($a.value.gpu // false),
                    terminal: ($a.value.terminal // false),
                    cats: (($t.value.categories // []) | join(",")),
                    desc: ($t.value.description // ""),
                    exec: ($a.value.exec | join(" "))
                }
            ]
            | unique_by([.id, .stack, .module, .exec])
            | sort_by([-.stack_num, (if .gpu then 1 else 0 end), .label])
            | to_entries[]
            | .value + {rank: .key}
        ]
        | sort_by([(if .rank == 0 then 0 else 1 end), .id, .rank])
        | .[]
        | [
            .id, .label, .stack, .module, (.gpu | tostring),
            (.terminal | tostring), .cats, .desc, .exec
          ][]
        | @base64
    ' "${stage}/merged.json" > "${launchers_b64}"

    # Generate .desktop entries with collision-proof filenames.
    local -A used_slug_counts=()
    local -A used_filenames=()
    local b_id b_label b_stack b_mod b_gpu b_term b_cats b_desc b_exec
    local tool_id label stack mod gpu terminal cats desc exec_joined
    while IFS= read -r b_id \
        && IFS= read -r b_label \
        && IFS= read -r b_stack \
        && IFS= read -r b_mod \
        && IFS= read -r b_gpu \
        && IFS= read -r b_term \
        && IFS= read -r b_cats \
        && IFS= read -r b_desc \
        && IFS= read -r b_exec; do
        tool_id="$(decode_b64 "${b_id}")"
        [ -n "${tool_id}" ] || continue
        label="$(decode_b64 "${b_label}")"
        stack="$(decode_b64 "${b_stack}")"
        mod="$(decode_b64 "${b_mod}")"
        gpu="$(decode_b64 "${b_gpu}")"
        terminal="$(decode_b64 "${b_term}")"
        cats="$(decode_b64 "${b_cats}")"
        desc="$(decode_b64 "${b_desc}")"
        exec_joined="$(decode_b64 "${b_exec}")"

        local safe_name safe_comment safe_title desktop_cats exec_line
        safe_name="$(sanitize_desktop_value "${label}")"
        safe_name="${safe_name:0:128}"
        [ -n "${safe_name}" ] || continue

        local slug count fname suffix n
        slug="$(desktop_slug "${tool_id}")"
        [ -n "${slug}" ] || continue
        count="${used_slug_counts[${slug}]:-0}"
        used_slug_counts["${slug}"]=$((count + 1))
        if [ "${count}" -eq 0 ] && [ -z "${used_filenames[eessi-${slug}.desktop]+x}" ]; then
            fname="eessi-${slug}.desktop"
        else
            suffix="${stack//./-}"
            [ "${gpu}" = "true" ] && suffix="${suffix}-gpu"
            n="${count}"
            [ "${n}" -eq 0 ] && n=1
            fname="eessi-${slug}-${suffix}-${n}.desktop"
            while [ -n "${used_filenames[${fname}]+x}" ]; do
                n=$((n + 1))
                fname="eessi-${slug}-${suffix}-${n}.desktop"
            done
        fi
        used_filenames["${fname}"]=1

        safe_comment="$(sanitize_desktop_value "${desc}")"
        safe_comment="${safe_comment:0:200}"
        [ -n "${safe_comment}" ] || safe_comment="${safe_name} via EESSI/${stack} (explicit selection, no DOI)"
        desktop_cats="$(desktop_categories "${cats}")"

        if [ "${terminal}" = "true" ]; then
            safe_title="$(sanitize_terminal_title "${safe_name}")"
            [ -n "${safe_title}" ] || safe_title="EESSI"
            exec_line="/usr/local/bin/eessi-launch --stack ${stack} -- ${mod} xfce4-terminal --disable-server --title=\"${safe_title}\" -x ${exec_joined}"
        else
            exec_line="/usr/local/bin/eessi-launch --stack ${stack} -- ${mod} ${exec_joined}"
        fi

        cat > "${stage}/applications/${fname}" <<EOF
[Desktop Entry]
Type=Application
Name=${safe_name}
Comment=${safe_comment}
Exec=${exec_line}
Terminal=false
X-Scidesktop-Category=EESSI
Categories=${desktop_cats}
EOF
        chmod 0644 "${stage}/applications/${fname}"
    done < "${launchers_b64}"
    rm -f "${launchers_b64}"

    # Serialize snapshot publication and pruning within this source namespace.
    local lock_fd snap_ts final_snap snap_name tmp_link prev_target
    exec {lock_fd}>"${ns_dir}/.lock"
    flock "${lock_fd}"
    snap_ts="$(date +%s)"
    final_snap="$(mktemp -d "${ns_dir}/snapshots/sync-${snap_ts}.XXXXXX")"
    rmdir "${final_snap}"
    snap_name="$(basename "${final_snap}")"
    prev_target=""
    if [ -L "${ns_dir}/current" ]; then
        prev_target="$(readlink "${ns_dir}/current" 2>/dev/null || true)"
    fi
    rm -f "${stage}/.in-use"
    if [ -n "${STAGE_LOCK_FD}" ]; then
        exec {STAGE_LOCK_FD}>&-
        STAGE_LOCK_FD=""
    fi
    mv -T "${stage}" "${final_snap}"
    STAGING_DIR=""
    tmp_link="$(mktemp -u "${ns_dir}/.current.tmp.XXXXXX")"
    ln -s "snapshots/${snap_name}" "${tmp_link}"
    mv -Tf "${tmp_link}" "${ns_dir}/current"

    # Keep the active snapshot, the immediate previous snapshot, and any
    # snapshot created within the last 24h; long-running Jupyter sessions copy
    # their launchers to container-local storage via session-apps-dir. Also
    # reap unlocked abandoned staging directories older than 10 minutes without
    # disturbing any still-running sync holding its .in-use flock.
    local old old_rel
    while IFS= read -r -d '' old; do
        old_rel="snapshots/$(basename "${old}")"
        [ "${old_rel}" = "snapshots/${snap_name}" ] && continue
        [ -n "${prev_target}" ] && [ "${old_rel}" = "${prev_target}" ] && continue
        rm -rf "${old}"
    done < <(find "${ns_dir}/snapshots" -maxdepth 1 -mindepth 1 -type d -name 'sync-*' -mmin +1440 -print0 2>/dev/null || true)
    local stale_stage
    while IFS= read -r -d '' stale_stage; do
        if [ ! -e "${stale_stage}/.in-use" ] || flock -n "${stale_stage}/.in-use" true 2>/dev/null; then
            rm -rf "${stale_stage}"
        fi
    done < <(find "${ns_dir}/snapshots" -maxdepth 1 -mindepth 1 -type d -name '.staging.*' -mmin +10 -print0 2>/dev/null || true)
    exec {lock_fd}>&-
}

show_catalog() {
    local eessi_modroot="${EESSI_MODULE_ROOT:-/cvmfs/software.eessi.io/init/modules}"
    if [ -d "${eessi_modroot}" ]; then
        echo "EESSI repository: mounted (/cvmfs/software.eessi.io)"
        local stacks
        stacks="$(find "${eessi_modroot}/EESSI" -maxdepth 1 -name '*.lua' -printf '%f\n' 2>/dev/null | sed 's/\.lua$//' | sort | tr '\n' ' ' || true)"
        [ -n "${stacks}" ] && echo "Available stacks: ${stacks}"
    else
        echo "EESSI repository: not mounted (/cvmfs/software.eessi.io)"
        echo "Hint: mount /cvmfs/software.eessi.io from the host/cluster or start with SCIDESKTOP_CVMFS_MODE=internal."
    fi

    echo
    echo "Quick start:"
    echo "  module load EESSI/${EESSI_DEFAULT_VERSION:-2025.06}"
    echo "  module avail"
    echo "  eessi-catalog sync    # refresh curated catalog & JupyterLab launchers"

    local expected="" apps_dir
    if ! expected="$(resolve_sources 2>/dev/null)"; then
        expected=""
    fi
    apps_dir="$(active_apps_dir_for_sources "${expected}")"
    if [ -n "${apps_dir}" ] && [ -d "${apps_dir}" ]; then
        echo
        echo "Desktop launchers (shown in JupyterLab EESSI section when EESSI is mounted):"
        local f name exec_cmd
        for f in "${apps_dir}"/*.desktop; do
            [ -f "${f}" ] || continue
            name="$(sed -n 's/^Name=//p' "${f}" | head -n 1)"
            exec_cmd="$(sed -n 's/^Exec=//p' "${f}" | head -n 1)"
            printf '  - %-32s %s\n' "${name}" "${exec_cmd}"
        done
    fi

    if [ -n "${expected}" ] && cache_matches_sources_for "${expected}"; then
        local ns_dir
        ns_dir="$(namespace_dir_for_sources "${expected}")"
        echo
        echo "Curated EESSI modules from live catalog (explicit selection; no DOI):"
        jq -r '
            .tools | to_entries | sort_by(.key)[]
            | .value as $t
            | ($t.apps | to_entries | sort_by(.key)[]
                | "  - \($t.package) [\(.value.stack)\(if .value.gpu then ", GPU" else "" end)]: \(.value.module)")
        ' "${ns_dir}/current/merged.json"
    elif [ -d "${STATIC_CATALOG_DIR}" ]; then
        echo
        echo "Curated EESSI modules for this image:"
        local f
        for f in "${STATIC_CATALOG_DIR}"/*.txt; do
            [ -f "${f}" ] || continue
            cat "${f}"
        done
    fi
}

cmd="${1:-list}"
case "${cmd}" in
    list)
        show_catalog
        ;;
    sync|refresh)
        sync_catalogs
        ;;
    urls)
        resolve_sources
        ;;
    apps-dir)
        active_apps_dir
        ;;
    session-apps-dir)
        session_apps_dir
        ;;
    json)
        expected="$(resolve_sources)"
        if cache_matches_sources_for "${expected}"; then
            ns_dir="$(namespace_dir_for_sources "${expected}")"
            cat "${ns_dir}/current/merged.json"
        else
            echo "eessi-catalog: no synced catalog cache found (run: eessi-catalog sync)" >&2
            exit 1
        fi
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "eessi-catalog: unknown command: ${cmd}" >&2
        usage
        exit 2
        ;;
esac
