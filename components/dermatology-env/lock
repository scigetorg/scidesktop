#!/bin/bash
# Regenerates linux-64.lock, linux-aarch64.lock, and requirements.lock.
# Strips packages already provided by the conda locks from requirements.lock so
# pip never overwrites conda-installed libraries.
set -euo pipefail
cd "$(dirname "$0")"
../conda-lock .
python_version=$(grep -o '/python-3\.[0-9]*' linux-64.lock | head -1 | cut -d- -f2)
tmp_lock="$(mktemp)"
trap 'rm -f "${tmp_lock}"' EXIT
uv pip compile requirements.in --quiet --generate-hashes --no-header \
    --python-version "${python_version}" --universal \
    --output-file "${tmp_lock}"

python3 - "${tmp_lock}" requirements.lock <<'PY'
import re, sys
from pathlib import Path

def norm(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()

def conda_names(lock_path: Path) -> set[str]:
    names = set()
    for line in lock_path.read_text().splitlines():
        if not line.startswith("https://"):
            continue
        fname = line.split("/")[-1].split("#")[0]
        parts = fname.rsplit("-", 2)
        if len(parts) == 3:
            names.add(norm(parts[0]))
    return names

conda_64 = conda_names(Path("linux-64.lock"))
conda_arm = conda_names(Path("linux-aarch64.lock"))
conda_pkgs = conda_64 & conda_arm
conda_pkgs_any = conda_64 | conda_arm
conda_to_pypi = {
    "matplotlib-base": "matplotlib",
    "dask-core": "dask",
    "pillow": "pillow",
    "pyyaml": "pyyaml",
}
for k, v in list(conda_to_pypi.items()):
    if k in conda_pkgs:
        conda_pkgs.add(norm(v))
    if k in conda_pkgs_any:
        conda_pkgs_any.add(norm(v))

explicit = set()
for line in Path("requirements.in").read_text().splitlines():
    s = line.split("#", 1)[0].strip()
    m = re.match(r"^([A-Za-z0-9_.-]+)", s)
    if m:
        explicit.add(norm(m.group(1)))

overlap = sorted(explicit & conda_pkgs_any)
if overlap:
    sys.exit(
        "ERROR: direct PyPI pin(s) in requirements.in overlap with conda-provided "
        f"package(s) ({', '.join(overlap)}). Choose whether environment.yml or "
        "requirements.in owns each package so pip never overwrites conda files."
    )
skip = conda_pkgs

raw_lines = Path(sys.argv[1]).read_text().splitlines()
out = ["# Generated by ./lock from requirements.in. Do not edit."]
i = 0
kept = 0
dropped = []
while i < len(raw_lines):
    line = raw_lines[i]
    m = re.match(r"^([A-Za-z0-9_.-]+)==", line)
    if m:
        pkg = norm(m.group(1))
        block = [line]
        i += 1
        while i < len(raw_lines) and (raw_lines[i].startswith(" ") or raw_lines[i].startswith("\t")):
            block.append(raw_lines[i])
            i += 1
        if pkg in skip:
            dropped.append(pkg)
            continue
        out.extend(block)
        kept += 1
    else:
        out.append(line)
        i += 1

Path(sys.argv[2]).write_text("\n".join(out) + "\n")
print(f"requirements.lock: {kept} packages ({len(dropped)} conda-provided omitted)")
PY
