#!/bin/bash
# Regenerates the locks:
#   linux-64.lock, linux-aarch64.lock
#                     the interpreter per architecture, as explicit conda
#                     package lists (../conda-lock)
#   requirements.lock DataLad, git-annex and every dependency, pinned with hashes
set -euo pipefail
cd "$(dirname "$0")"
../conda-lock .
python_version=$(grep -o '/python-3\.[0-9]*' linux-64.lock | head -1 | cut -d- -f2)
# --universal: one lock for every architecture. Each pin carries the hashes of
# all its files, so the hashed install is exact whichever wheel it picks; a
# dependency only some platforms need carries a marker.
uv pip compile requirements.in --quiet --generate-hashes --no-header \
    --python-version "${python_version}" --universal \
    --output-file requirements.lock
sed -i '1i # Generated by ./lock from requirements.in. Do not edit.' requirements.lock
echo "requirements.lock: $(grep -c '==' requirements.lock) packages"
