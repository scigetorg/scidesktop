{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "neurodesk": {
      "package": "@ai-sdk/openai-compatible",
      "name": "Neurodesk",
      "settings": {
        "baseURL": "https://llm.neurodesk.org/openai",
        "apiKey": "{env:NEURODESK_API_KEY}"
      },
      "models": {
        "neurodesk": {
          "name": "neurodesk",
          "limit": {
            "context": 131000,
            "output": 8192
          }
        }
      }
    }
  }
}
