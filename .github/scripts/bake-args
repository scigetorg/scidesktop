#!/bin/bash
# Arguments for `docker buildx bake` in CI, one per line.
#
#   bake-args <arch> <tag> [write-cache|no-cache]
#
# Every folder in components/ and images/ gets its own GitHub Actions cache
# scope per architecture, so an unchanged component is not rebuilt and the two
# architectures do not evict each other's layers. Every image in images/ is
# tagged <image>:<tag>. The lists come from the folders: a new component or
# image needs no change here or in the workflows. `no-cache` names no cache
# at all, for a build that must not depend on what the cache still holds.
#
# Writing the cache is best effort (ignore-error): GitHub throttles cache
# writes per repository, and a build that passed must not fail because its
# layers could not be saved for the next one.
set -euo pipefail
arch="${1:?usage: bake-args <arch> <tag> [write-cache|no-cache]}"
tag="${2:?usage: bake-args <arch> <tag> [write-cache|no-cache]}"
cd "$(dirname "$0")/../.."
for dockerfile in components/*/Dockerfile images/*/Dockerfile; do
    target="$(basename "$(dirname "${dockerfile}")")"
    [ "${3:-}" != no-cache ] || continue
    echo "--set=${target}.cache-from=type=gha,scope=${target}-${arch}"
    if [ "${3:-}" = write-cache ]; then
        echo "--set=${target}.cache-to=type=gha,scope=${target}-${arch},mode=max,ignore-error=true"
    fi
done
if [ "${3:-}" != no-cache ]; then
    echo "--set=os-ubuntu-build.cache-from=type=gha,scope=os-ubuntu-build-${arch}"
    if [ "${3:-}" = write-cache ]; then
        echo "--set=os-ubuntu-build.cache-to=type=gha,scope=os-ubuntu-build-${arch},mode=max,ignore-error=true"
    fi
fi
for dockerfile in images/*/Dockerfile; do
    image="$(basename "$(dirname "${dockerfile}")")"
    echo "--set=${image}.tags=${image}:${tag}"
done
version="${SCIDESKTOP_VERSION:-$(TZ=UTC git show --no-patch --date=format-local:%Y-%m-%d --format=%cd HEAD)}"
echo "--set=scidesktop.args.SCIDESKTOP_VERSION=${version}"
