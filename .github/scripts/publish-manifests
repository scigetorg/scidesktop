#!/bin/bash
# Joins one CI run's per-architecture candidates into a multi-arch image and
# tags it, for each image named.
#
#   publish-manifests <registry>/<owner> <candidate> <image>...
#
# The candidates are <image>:<candidate>-<arch>, one per architecture in
# components/target-arch. Tags written: the commit's short SHA (the one to
# deploy), then the commit's UTC date and latest. The candidate tags stay:
# the multi-arch image points at them.
#
# Two passes, so a failure on one image moves no image's rolling tags: every
# image gets its short-SHA tag and is checked first, then the date and latest
# tags move for all. They move only while GITHUB_SHA is still the head of the
# branch (PUBLISH_BRANCH, default main), read again before each image's tags
# move because the branch can advance during the first pass: an older run
# publishes its short SHA and leaves the rolling tags where they are.
set -euo pipefail
registry="${1:?usage: publish-manifests <registry>/<owner> <candidate> <image>...}"
candidate="${2:?}"
shift 2
cd "$(dirname "$0")/../.."
arches="$(components/target-arch list)"
sha="${GITHUB_SHA:?}"
short_sha="$(printf '%.7s' "${sha}")"
branch="${PUBLISH_BRANCH:-main}"
date="$(TZ=UTC git show --no-patch --date=format-local:%Y-%m-%d --format=%cd "${sha}")"

for image in "$@"; do
    repo="${registry,,}/${image}"
    sources=()
    for arch in ${arches}; do
        sources+=("${repo}:${candidate}-${arch}")
    done
    docker buildx imagetools create --tag "${repo}:${short_sha}" "${sources[@]}"
    # The moving tags follow only an image that holds every architecture.
    published="$(docker buildx imagetools inspect "${repo}:${short_sha}" \
        --format '{{range .Manifest.Manifests}}{{if eq .Platform.OS "linux"}}{{.Platform.Architecture}} {{end}}{{end}}')"
    if [ "$(printf '%s\n' ${published} | sort)" != "$(printf '%s\n' ${arches} | sort)" ]; then
        echo "publish-manifests: ${repo}:${short_sha} holds '${published}', not '${arches}'" >&2
        exit 1
    fi
    echo "published ${repo}:${short_sha} for ${arches}"
done

for image in "$@"; do
    repo="${registry,,}/${image}"
    head="$(git ls-remote origin "refs/heads/${branch}" | cut -f 1)"
    [ -n "${head}" ] || { echo "publish-manifests: origin has no branch ${branch}" >&2; exit 1; }
    if [ "${head}" != "${sha}" ]; then
        echo "publish-manifests: ${short_sha} is not the head of ${branch} ($(printf '%.7s' "${head}")); :latest and :${date} of ${image} and any image after it are left where they are"
        exit 0
    fi
    docker buildx imagetools create --tag "${repo}:${date}" --tag "${repo}:latest" "${repo}:${short_sha}"
    echo "tagged ${repo}:${date} and :latest"
done
