      "description": "Component workflow-engines: its versions in docker-bake.hcl join the component's group.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "nextflow-io/nextflow",
        "askimed/nf-test",
        "viash-io/viash",
        "adoptium/temurin21-binaries"
      ],
      "groupName": "component workflow-engines",
      "addLabels": [
        "component:workflow-engines"
      ]
    },
    {
      "description": "Temurin 21 releases use 3- or 4-part versions with a +build number (e.g. 21.0.13+7, 21.0.13.1+2). Anchor the constant 21. prefix so optional 4th segment maps to patch (defaulting to 0) and +N always maps to build.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "adoptium/temurin21-binaries"
      ],
      "versioning": "regex:^21\\.(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?\\+(?<build>\\d+)$"
    },
