{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Australia/Brisbane",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/^components/jupyter-env/requirements\\.in$/",
      "/^components/selkies/requirements\\.in$/",
      "/^components/ai-ready/requirements\\.in$/",
      "/^components/ai-ready/airflow-requirements\\.in$/",
      "/^components/datalad/requirements\\.in$/",
      "/^components/lightcone/requirements\\.in$/",
      "/^components/workflow-engines/requirements\\.in$/",
      "/^components/microscopy-env/requirements\\.in$/",
      "/^components/datascience-env/requirements\\.in$/",
      "/^components/dermatology-env/requirements\\.in$/",
      "/^components/preclinical-env/requirements\\.in$/",
      "/^components/molecular-imaging-env/requirements\\.in$/",
      "/^components/genomics-env/requirements\\.in$/",
      "/^components/neuroimaging-env/requirements\\.in$/",
      "/^components/notebook-intelligence/requirements\\.in$/"
    ]
  },
  "customDatasources": {
    "open-vsx": {
      "defaultRegistryUrlTemplate": "https://open-vsx.org/api/{{packageName}}",
      "transformTemplates": [
        "{\"releases\": $map($keys(allVersions)[$ != \"latest\"], function($v) { {\"version\": $v} })}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Base and build-stage image digests, grouped into one review.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "container image digests"
    },
    {
      "description": "A major toolchain bump changes the artefacts these stages produce.",
      "matchPackageNames": [
        "alpine",
        "golang",
        "node",
        "python",
        "ubuntu"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Selkies releases; every bump needs the desktop smoke-tested.",
      "matchDepNames": [
        "selkies"
      ],
      "groupName": "selkies"
    },
    {
      "matchPackageNames": [
        "jupyter-server-proxy"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Component os-ubuntu: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/os-ubuntu/**"
      ],
      "groupName": "component os-ubuntu",
      "addLabels": [
        "component:os-ubuntu"
      ]
    },
    {
      "description": "Component eessi-cvmfs: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/eessi-cvmfs/**"
      ],
      "groupName": "component eessi-cvmfs",
      "addLabels": [
        "component:eessi-cvmfs"
