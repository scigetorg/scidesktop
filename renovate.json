{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Australia/Brisbane",
  "schedule": [
    "before 6am on monday"
  ],
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/^components/selkies/requirements\\.in$/",
      "/^components/ai-ready/requirements\\.in$/",
      "/^components/ai-ready/airflow-requirements\\.in$/",
      "/^components/datalad/requirements\\.in$/"
    ]
  },
  "customDatasources": {
    "open-vsx": {
      "defaultRegistryUrlTemplate": "https://open-vsx.org/api/{{packageName}}",
      "transformTemplates": [
        "{\"releases\": $map($keys(allVersions)[$ != \"latest\"], function($v) { {\"version\": $v} })}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Base and build-stage image digests, grouped into one review.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "container image digests"
    },
    {
      "description": "A major toolchain bump changes the artefacts these stages produce.",
      "matchPackageNames": [
        "alpine",
        "golang",
        "node",
        "python",
        "ubuntu"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Selkies releases; every bump needs the desktop smoke-tested.",
      "matchDepNames": [
        "selkies"
      ],
      "groupName": "selkies"
    },
    {
      "matchPackageNames": [
        "jupyter-server-proxy"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Component os-ubuntu: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/os-ubuntu/**"
      ],
      "groupName": "component os-ubuntu",
      "addLabels": [
        "component:os-ubuntu"
      ]
    },
    {
      "description": "Component jupyter-env: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/jupyter-env/**"
      ],
      "groupName": "component jupyter-env",
      "addLabels": [
        "component:jupyter-env"
      ]
    },
    {
      "description": "Component selkies: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/selkies/**"
      ],
      "groupName": "component selkies",
      "addLabels": [
        "component:selkies"
      ]
    },
    {
      "description": "Component apptainer: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/apptainer/**"
      ],
      "groupName": "component apptainer",
      "addLabels": [
        "component:apptainer"
      ]
    },
    {
      "description": "Component lmod: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/lmod/**"
      ],
      "groupName": "component lmod",
      "addLabels": [
        "component:lmod"
      ]
    },
    {
      "description": "Component sciget: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/sciget/**"
      ],
      "groupName": "component sciget",
      "addLabels": [
        "component:sciget"
      ]
    },
    {
      "description": "Component startup: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/startup/**"
      ],
      "groupName": "component startup",
      "addLabels": [
        "component:startup"
      ]
    },
    {
      "description": "Component micromamba: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/micromamba/**"
      ],
      "groupName": "component micromamba",
      "addLabels": [
        "component:micromamba"
      ]
    },
    {
      "description": "Component ai-ready: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/ai-ready/**"
      ],
      "groupName": "component ai-ready",
      "addLabels": [
        "component:ai-ready"
      ]
    },
    {
      "description": "Component coding-agents: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/coding-agents/**"
      ],
      "groupName": "component coding-agents",
      "addLabels": [
        "component:coding-agents"
      ]
    },
    {
      "description": "Component t3-code: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/t3-code/**"
      ],
      "groupName": "component t3-code",
      "addLabels": [
        "component:t3-code"
      ]
    },
    {
      "description": "Component code-server: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/code-server/**"
      ],
      "groupName": "component code-server",
      "addLabels": [
        "component:code-server"
      ]
    },
    {
      "description": "Component datalad: its updates arrive together and run its own test.",
      "matchFileNames": [
        "components/datalad/**"
      ],
      "groupName": "component datalad",
      "addLabels": [
        "component:datalad"
      ]
    },
    {
      "description": "AI Ready: Airflow's constraints are per Python minor, and a PostgreSQL major cannot open the data directory an earlier one created in a user's home.",
      "matchFileNames": [
        "components/ai-ready/environment.yml"
      ],
      "matchDepNames": [
        "python",
        "postgresql"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Component os-ubuntu: its versions in docker-bake.hcl join the component's group.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "ubuntu",
        "cvmfs/cvmfs"
      ],
      "groupName": "component os-ubuntu",
      "addLabels": [
        "component:os-ubuntu"
      ]
    },
    {
      "description": "Component micromamba: its versions in docker-bake.hcl join the component's group.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "mamba-org/micromamba-releases"
      ],
      "groupName": "component micromamba",
      "addLabels": [
        "component:micromamba"
      ]
    },
    {
      "description": "Component apptainer: its versions in docker-bake.hcl join the component's group.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "apptainer/apptainer",
        "apptainer-go",
        "google.golang.org/grpc",
        "golang.org/x/crypto"
      ],
      "groupName": "component apptainer",
      "addLabels": [
        "component:apptainer"
      ]
    },
    {
      "description": "Component lmod: its versions in docker-bake.hcl join the component's group.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "TACC/Lmod"
      ],
      "groupName": "component lmod",
      "addLabels": [
        "component:lmod"
      ]
    },
    {
      "description": "Component sciget: its versions in docker-bake.hcl join the component's group.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "sciget",
        "sciget-go"
      ],
      "groupName": "component sciget",
      "addLabels": [
        "component:sciget"
      ]
    },
    {
      "description": "Component ai-ready: its versions in docker-bake.hcl join the component's group.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "ai-ready-containers"
      ],
      "groupName": "component ai-ready",
      "addLabels": [
        "component:ai-ready"
      ]
    },
    {
      "description": "Component coding-agents: its versions in docker-bake.hcl join the component's group. Each bump needs both *_SHA256 variables of that agent updated.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "openai/codex",
        "claude-code",
        "opencode"
      ],
      "groupName": "component coding-agents",
      "addLabels": [
        "component:coding-agents"
      ]
    },
    {
      "description": "Component t3-code: a bump needs both T3_CODE_SHA256 variables updated, and its test fails if the web client moved an anchor the base-path adapter rewrites (docs/coding-agents.md).",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "pingdotgg/t3code"
      ],
      "groupName": "component t3-code",
      "addLabels": [
        "component:t3-code"
      ]
    },
    {
      "description": "Component code-server: a bump needs both CODE_SERVER_SHA256 variables updated, from the release's sha256 digests of code-server-<version>-linux-{amd64,arm64}.tar.gz.",
      "matchFileNames": [
        "docker-bake.hcl"
      ],
      "matchDepNames": [
        "coder/code-server"
      ],
      "groupName": "component code-server",
      "addLabels": [
        "component:code-server"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Every annotated version in docker-bake.hcl: a '# renovate:' comment, then the variable on the next line.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: packageName=(?<packageName>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\nvariable \"[A-Z0-9_]+\" \\{ default = \"(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\" \\}"
      ]
    },
    {
      "description": "sciget commit built into the image until sciget publishes an image.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "variable \"SCIGET_COMMIT\" \\{ default = \"(?<currentDigest>[0-9a-f]{40})\" \\}"
      ],
      "depNameTemplate": "sciget",
      "packageNameTemplate": "https://github.com/scigetorg/sciget",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    },
    {
      "description": "AI Ready workshop commit; a bump needs components/ai-ready/lock run before it builds.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "variable \"AI_READY_COMMIT\" \\{ default = \"(?<currentDigest>[0-9a-f]{40})\" \\}"
      ],
      "depNameTemplate": "ai-ready-containers",
      "packageNameTemplate": "https://github.com/IntersectAustralia/ai-ready-containers",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    },
    {
      "description": "FreeBrowse fork commit; the build stops if the patched viewer registration moved.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-bake\\.hcl$/"
      ],
      "matchStrings": [
        "variable \"FREEBROWSE_COMMIT\" \\{ default = \"(?<currentDigest>[0-9a-f]{40})\" \\}"
      ],
      "depNameTemplate": "freebrowse",
      "packageNameTemplate": "https://github.com/neurodesk/freebrowse",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    },
    {
      "description": "Exact pins in conda environment files; regenerate the lock with ./lock.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/[^/]+/environment\\.yml$/"
      ],
      "matchStrings": [
        "-\\s+(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[^\\s#]+)"
      ],
      "packageNameTemplate": "conda-forge/{{depName}}",
      "datasourceTemplate": "conda"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "security"
    ]
  }
}
